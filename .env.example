# -----------------------------------------------------------------------------
# Sobra, variáveis de ambiente.
# Copie para .env.local e preencha. Nunca versione o arquivo preenchido.
# -----------------------------------------------------------------------------


# --- Front (Cloudflare Pages) ------------------------------------------------
# Tudo com prefixo VITE_ vai para o bundle e é visível no navegador.
# Só coloque aqui o que pode ser público.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL para onde o Google devolve depois do login.
VITE_APP_URL=


# --- Supabase (administração e migrations) -----------------------------------
# Nunca exponha a service role no front. Ela passa por cima do RLS.

SUPABASE_PROJECT_REF=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=


# --- Cloudflare Worker do Telegram -------------------------------------------
# Gravar como secret (npx wrangler secret put NOME), não em wrangler.toml.

# Token do bot, vem do BotFather.
TELEGRAM_BOT_TOKEN=

# String longa e aleatória, definida por você. O Telegram devolve em
# X-Telegram-Bot-Api-Secret-Token e o Worker compara antes de ler o corpo.
TELEGRAM_WEBHOOK_SECRET=

# Único chat_id autorizado a falar com o bot.
TELEGRAM_ALLOWED_CHAT_ID=

# UUID do usuário no Supabase. O Worker escreve com service role, então precisa
# fixar o user_id na mão.
APP_USER_ID=


# --- API da Anthropic --------------------------------------------------------
# Usada pelo Worker para interpretar linguagem solta.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
